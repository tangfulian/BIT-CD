# 数据集（体量庞大，不适合 Git 管理）
datasets/

# 环境变量（含 API Key，严禁提交）
.env
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# 数据库
*.db

# 模型检查点
checkpoints/

# 推理结果
results/
predict/
samples/predict/
vis/

# 上传文件
uploads/

# Jupyter
.ipynb_checkpoints/

# 压缩包
*.zip
*.rar
*.7z
*.tar.gz
*.tgz

# 编辑/脚本备份文件
*.bak
*.orig

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# PyTorch 模型权重
*.pt
*.pth

# Browser Agent Chrome 用户目录
browser_profile/

# Conda 环境（体积大）
environment.yml

# 日志
logs/

# 测试期间生成的临时数据库
tests/test_bitcd.db
verify_tmp.db

# 本地密钥配置（不入库）
frontend/js/config.local.js

# 技能目录：实体文件在 .agents/（已入库），.claude/skills/ 下是它的 junction。
# 不忽略的话，git add -A 会把同一份内容重复入库一遍。
.claude/skills/frontend-design/

# Claude Code 的本地权限配置：记的是本机绝对路径（含用户名），换台机器全无意义，
# 而且每次累积权限都会混进提交。这里没有团队级配置，所以两个都不入库。
.claude/settings.json
.claude/settings.local.json
