# ============================================================
# BIT_CD 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# --- 安全相关（务必修改） ---

# JWT 签名密钥（生产环境请用 openssl rand -hex 32 生成）
# 未设置时启动时自动生成随机值，但重启后所有用户需重新登录
JWT_SECRET=replace-with-random-hex-string

# 管理员初始密码（仅数据库首次初始化时使用一次）
# 未设置时启动时自动生成随机值（控制台会打印，请注意保存）
ADMIN_DEFAULT_PASSWORD=replace-with-strong-password

# 管理员重置用户密码时的默认密码
USER_RESET_PASSWORD=replace-with-strong-password

# --- 外部服务 API Key ---

# 阿里云 DashScope API Key（通义千问 AI 对话/分类）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 高德地图 Web API Key（逆地理编码）
AMAP_WEB_KEY=your_amap_web_key_here

# --- AI Agent（Browser Use 自然语言操控前端） ---
# 前端地址（Agent 将操控此地址的页面）
AGENT_FRONTEND_URL=http://localhost:5500
# Agent 注入登录态时使用的账号名。
# 不需要配密码：Agent 直接签发 token 并经 CDP 注入浏览器 localStorage。
AGENT_USERNAME=admin
# 是否无头模式运行浏览器（生产环境设为 true）
AGENT_BROWSER_HEADLESS=true
# Agent 单次任务最大步数
AGENT_MAX_STEPS=15

# --- CORS（跨域请求白名单，逗号分隔） ---
# 生产环境仅填写你的前端域名，例如 https://your-domain.com
ALLOWED_ORIGINS=http://localhost:63342,http://localhost:3000,http://127.0.0.1:8000

# --- 数据库连接 ---
# 注意：口令请替换为真实值，不要直接沿用下面的占位符。
# 仓库默认的 docker-compose.yml 用 SQLite，走最后一行即可。
# Docker 部署（连 PostgreSQL 容器）:
DATABASE_URL=postgresql://bitcd:CHANGE_ME@db:5432/bitcd
# 本地 PostgreSQL:
# DATABASE_URL=postgresql://bitcd:CHANGE_ME@localhost:5432/bitcd
# 本地 SQLite（无需额外安装数据库）:
# DATABASE_URL=sqlite:///./blackland.db
