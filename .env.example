# ============================================================
# BIT_CD 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# --- 安全相关（务必修改） ---

# JWT 签名密钥（生产环境请用 openssl rand -hex 32 生成）
# 未设置时启动时自动生成随机值，但重启后所有用户需重新登录
JWT_SECRET=replace-with-random-hex-string

# 管理员初始密码（仅数据库首次初始化时使用一次）
# 未设置时启动时自动生成随机值（控制台会打印，请注意保存）
ADMIN_DEFAULT_PASSWORD=replace-with-strong-password

# 管理员重置用户密码时的默认密码
USER_RESET_PASSWORD=replace-with-strong-password

# --- 外部服务 API Key ---

# 高德地图 Web API Key（逆地理编码）
AMAP_WEB_KEY=your_amap_web_key_here

# --- LLM 服务商（AI 对话 / 分类 / 报告草稿 / Agent） ---
# 换服务商只改这几个变量，不用动代码。

# 当前默认 DeepSeek。若换回百炼，把 BASE_URL 改成
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# 并把两个模型名换成 qwen3.7-flash / qwen3.7-plus。
LLM_BASE_URL=https://api.deepseek.com

# LLM 的密钥。没有回退 —— 缺了会直接报「未配置」，不会静默指向别家。
LLM_API_KEY=your_llm_api_key_here

# 文本用途：变化类型分类、分析报告、定损说明草稿
LLM_MODEL=deepseek-v4-flash

# Agent 用途：需要**同时**支持视觉与 Function Calling。
# 实测 deepseek-v4-flash 两项都支持；
# **不要用 deepseek-v4-pro** —— 它不接受图片输入。
# 留空则跟随 LLM_MODEL。
LLM_AGENT_MODEL=deepseek-v4-flash

# Agent 备用模型。留空 = 不启用（默认）。
# 只有**跨服务商**的备用才有意义 —— 同一账号同一家会在限流/欠费时一起挂。
# 注意跨服务商要改 agent_service.py 里的 LLM 类（DeepSeek 用 ChatDeepSeek，
# Qwen 用 ChatOpenAI），不是填个模型名就行。
LLM_AGENT_FALLBACK_MODEL=

# --- LLM 每日调用预算 ---
# 按天累计的调用次数上限，超出即拒绝。用来拦住失控的循环调用 ——
# 端点限流是**按分钟**的，一个每 20 秒发一次的循环在它放开后一天能跑掉几千次，
# 而且不会有任何报错，直到额度见底。
# 本项目的 LLM key 与开发者的 Claude Code 共用同一份额度，所以值得设一道闸。
# 正常演示一天用不到（一次检测 1 次分类调用），默认 500 足够。
# 设为 0 关闭限制。
LLM_DAILY_CALL_LIMIT=500

# --- AI Agent（Browser Use 自然语言操控前端） ---
# 前端地址（Agent 将操控此地址的页面）
AGENT_FRONTEND_URL=http://localhost:5500
# Agent 注入登录态时使用的账号名。
# 不需要配密码：Agent 直接签发 token 并经 CDP 注入浏览器 localStorage。
AGENT_USERNAME=admin
# 是否无头模式运行浏览器（生产环境设为 true）
AGENT_BROWSER_HEADLESS=true
# Agent 单次任务最大步数
AGENT_MAX_STEPS=15

# --- CORS（跨域请求白名单，逗号分隔） ---
# 生产环境仅填写你的前端域名，例如 https://your-domain.com
ALLOWED_ORIGINS=http://localhost:63342,http://localhost:3000,http://127.0.0.1:8000

# --- 数据库连接 ---
# 注意：口令请替换为真实值，不要直接沿用下面的占位符。
# 仓库默认的 docker-compose.yml 用 SQLite，走最后一行即可。
# Docker 部署（连 PostgreSQL 容器）:
DATABASE_URL=postgresql://bitcd:CHANGE_ME@db:5432/bitcd
# 本地 PostgreSQL:
# DATABASE_URL=postgresql://bitcd:CHANGE_ME@localhost:5432/bitcd
# 本地 SQLite（无需额外安装数据库）:
# DATABASE_URL=sqlite:///./blackland.db
